              "path": ["api", "cache", "health"]
            }
          }
        },
        {
          "name": "System & Redis Metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cache/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache", "metrics"]
            }
          }
        }
      ]
