# ==============================================================================
# Micro-Redis Service Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
ENABLE_REQUEST_LOGGING=true

# Redis Connection Mode: 'standalone' or 'sentinel'
REDIS_MODE=standalone

# Standalone Redis Configuration (Used when REDIS_MODE=standalone)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Sentinel High Availability Configuration (Used when REDIS_MODE=sentinel)
REDIS_SENTINEL_MASTER_NAME=mymaster
REDIS_SENTINEL_NODES=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
REDIS_SENTINEL_PASSWORD=

# Connection Reliability & Retry Strategy
REDIS_CONNECT_TIMEOUT=10000
REDIS_MAX_RETRIES=5
DEFAULT_TTL=3600
