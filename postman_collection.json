    {
      "name": "Key-Value Operations",
      "item": [
        {
          "name": "Set Cache (String with TTL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"user:session:1001\",\n  \"value\": {\n    \"userId\": 1001,\n    \"username\": \"johndoe\",\n    \"roles\": [\"admin\"]\n  },\n  \"ttl\": 3600,\n  \"type\": \"string\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cache",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache"]
            }
          }
        },
        {
          "name": "Get Cache by Key",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cache/user:session:1001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache", "user:session:1001"]
            }
          }
        },
        {
          "name": "Set Cache (Hash)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"user:profile:1001\",\n  \"value\": {\n    \"name\": \"John Doe\",\n    \"department\": \"Engineering\"\n  },\n  \"ttl\": 7200,\n  \"type\": \"hash\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cache",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache"]
            }
          }
        },
        {
          "name": "Atomic Increment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"ratelimit:ip:127.0.0.1\",\n  \"amount\": 1,\n  \"ttl\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cache/increment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache", "increment"]
            }
          }
        },
        {
          "name": "Purge by Pattern",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pattern\": \"user:*\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cache/purge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache", "purge"]
            }
          }
        },
        {
          "name": "Delete Key",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/cache/user:session:1001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cache", "user:session:1001"]
            }
          }
        }
      ]
    },
    {
